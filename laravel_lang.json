{
    "$schema": "https://raw.githubusercontent.com/Laravel-Lang/mona/main/resources/laravel-lang.schema.json",
    "plugins": [
        {
            "vendor": "laravel/framework",
            "files": [
                {
                    "source": "validation.php",
                    "target": "{locale}/validation.php"
                }
            ]
        },
        {
            "vendor": "laravel/lumen-framework",
            "files": [
                {
                    "source": "validation.php",
                    "target": "{locale}/validation.php"
                }
            ]
        }
    ]
}
